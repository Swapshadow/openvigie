# Production image for the OpenVigie web app (vinext / Vite / Cloudflare stack).
# Mirrors the proven ./Dockerfile and adds prod hardening: NODE_ENV, dumb-init,
# a non-root user and a health check.
FROM node:22.23.2-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ dumb-init curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install --global pnpm@11.19.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm config set fetch-timeout 900000 \
 && pnpm config set fetch-retries 8 \
 && pnpm config set fetch-retry-maxtimeout 180000 \
 && pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

RUN groupadd --system --gid 1001 nodejs \
 && useradd --system --uid 1001 --gid nodejs --home /app nextjs \
 && chown -R nextjs:nodejs /app
USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
  CMD curl -fsS http://localhost:3000/ || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["pnpm", "start", "--", "--host", "0.0.0.0"]
