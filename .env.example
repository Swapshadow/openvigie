# Optional. OpenVigie works without a key, but NVD grants a higher request rate
# when one is configured. Request a key at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# CVE snapshots for every monitored product/version are refreshed daily.
OPENVIGIE_REFRESH_SECONDS=86400

# Optional. Official RSS/Atom feeds are refreshed every 3 hours by default.
# The minimum accepted value is 1800 seconds.
OPENVIGIE_FEED_REFRESH_SECONDS=10800
